# Noms des variables uniquement. Les vraies valeurs vont dans l'environnement du serveur, jamais dans le dépôt.
# Source de prix (spec 0002) : cTrader, compte démo IC Markets, portée « accounts » (lecture seule)
PRICE_SOURCE=ctrader_icmarkets
CTRADER_ENV=demo
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_ACCOUNT_ID=
# Premier jeton seulement : ensuite le worker le renouvelle et le garde en base.
CTRADER_ACCESS_TOKEN=
CTRADER_REFRESH_TOKEN=
CTRADER_SYMBOL=USDJPY
# Jours de fermeture du marché (dates fixes MM-JJ), par exemple 12-25,01-01
MARKET_HOLIDAYS=
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DATABASE_URL=
# Documentation de l'API (/api/docs) : fermée par défaut, true en local seulement.
API_DOCS=

# Déploiement sur le VPS (deploy/docker-compose.yml)
POSTGRES_PASSWORD=
HELLOFEDGE_DOMAIN=
IMAGE_TAG=
